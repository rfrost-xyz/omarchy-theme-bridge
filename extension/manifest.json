{
  "manifest_version": 3,
  "name": "Omarchy Webapp Theme",
  "version": "0.1.0",
  "description": "Keeps Notion and Slack in step with the active Omarchy theme.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.notion.com/*"
      ],
      "js": [
        "content/colour.js",
        "content/palette.js",
        "adapters/notion/adapter.js"
      ],
      "css": [
        "adapters/notion/adapter.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://app.slack.com/*"
      ],
      "js": [
        "content/colour.js",
        "content/palette.js",
        "adapters/slack/adapter.js"
      ],
      "css": [
        "adapters/slack/adapter.css"
      ],
      "run_at": "document_start"
    }
  ]
}
