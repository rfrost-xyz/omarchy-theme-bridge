#!/bin/bash
# Run every check: syntax, helper, installer, extension unit and headless browser tests.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

echo "== shell syntax"
for script in install.sh uninstall.sh scripts/common.sh scripts/check; do
  bash -n "$script"
done
for script in scripts/*.py; do
  python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "$script"
done
echo "== helper"
python3 -m unittest discover -s tests/host
echo "== installer"
python3 -m unittest discover -s tests/install
echo "== extension unit"
node --test tests/extension/
echo "== headless Chromium"
node --test --test-concurrency=1 --test-timeout=60000 tests/e2e/
echo "== openspec"
if ! command -v mise >/dev/null; then
  echo "mise not found; install mise to run the OpenSpec version pinned in mise.toml" >&2
  exit 1
fi
pinned=$(mise current npm:@fission-ai/openspec)
running=$(mise exec -- openspec --version)
if [[ $running != "$pinned" ]]; then
  echo "openspec $running is not the $pinned pinned in mise.toml; run mise install" >&2
  exit 1
fi
mise exec -- openspec validate --all --strict --no-interactive
mise exec -- openspec validate --archived --strict --no-interactive
